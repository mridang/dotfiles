[user]
	name = Mridang Agarwalla
	email = mridang.agarwalla@gmail.com

[core]
	excludesfile = ~/.gitignore_global
	editor = micro
	pager = delta
	autocrlf = input

[push]
	default = current

[color]
	ui = false
	branch = always
	diff = always
	interactive = always
	status = always
	grep = always
	pager = true
	decorate = always
	showbranch = always

[alias]
    recent="!git for-each-ref --sort=-committerdate --count=10 --format='%(refname:short)' refs/heads/"
    rename = "!fn() { git branch -m $1 $2; git push origin :$1; git push --set-upstream origin $2; }; fn"
    compact = "!fn() { git reflog expire --all --expire=now; git gc --prune=now --aggressive; }; fn"

# URL shorthands

[url "git@github.com:"]

	insteadOf = "gh:"
	pushInsteadOf = "github:"
	pushInsteadOf = "git://github.com/"

[url "git://github.com/"]

	insteadOf = "github:"

[url "git@gist.github.com:"]

	insteadOf = "gst:"
	pushInsteadOf = "gist:"
	pushInsteadOf = "git://gist.github.com/"

[url "git://gist.github.com/"]

	insteadOf = "gist:"
[commit]
	template = ~/.stCommitMsg
[pull]
	rebase = false
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[init]
	defaultBranch = master

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or omit for auto-detection

[merge]
    conflictstyle = zdiff3
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
